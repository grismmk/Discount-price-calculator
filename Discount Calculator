#include <stdio.h>

int main()  
{
    float price, discount, savings, final_price;

    printf("Enter original item price: ");
    scanf("%f", &price);

    printf("Enter discount percentage: ");
    scanf("%f", &discount);

    savings = price * (discount / 100);
    final_price = price - savings;

    printf("Money saved: %.2f\n", savings);
    printf("Final sale price: %.2f\n", final_price);

    return 0;
}
